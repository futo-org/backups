+  private async getWalArchiving(): Promise<ImmichWalArchiving | undefined> {
+    if (process.env.IMMICH_FUTO_BACKUPS_WAL_ARCHIVING !== 'true') {
+      return;
+    }
+
+    const major = coerce(await this.databaseRepository.getPostgresVersion())?.major;
+    if (!major) {
+      return;
+    }
+
+    return {
+      binDir: `/usr/lib/postgresql/${major}/bin`,
+      stagingPath: join(StorageCore.getBaseFolder(StorageFolder.Backups), 'yucca-wal'),
+      connection: this.getDatabaseConnection(),
+    };
+  }
+
+  private getDatabaseConnection(): ImmichWalArchiving['connection'] {
+    const { config } = this.configRepository.getEnv().database;
+    if (config.connectionType === 'parts') {
+      const { host, port, username, password, database } = config;
+      return { host, port, user: username, password, database };
+    }
+
+    const url = new URL(config.url);
+    return {
+      host: url.hostname,
+      port: Number(url.port || 5432),
+      user: decodeURIComponent(url.username || 'postgres'),
+      password: decodeURIComponent(url.password),
+      database: decodeURIComponent(url.pathname.slice(1)) || 'immich',
+    };
+  }
+
