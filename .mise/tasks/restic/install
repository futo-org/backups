#!/usr/bin/env bash
#MISE description="Install the restic build the standalone image ships into .mise/bin"
set -euo pipefail

root=$(cd "$(dirname "$0")/../../.." && pwd)
image=$(sed -n 's/^ARG RESTIC_IMAGE=//p' "$root/packages/standalone-app/Dockerfile")
bin="$root/.mise/bin"
marker="$bin/.restic-image"

if [ -x "$bin/restic" ] && [ "$(cat "$marker" 2>/dev/null)" = "$image" ]; then
  exit 0
fi

mkdir -p "$bin"
if [ "$(uname -s)" = Linux ]; then
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) echo "no restic image for $(uname -m)" >&2 && exit 1 ;;
  esac
  crane export --platform "linux/$arch" "$image" - | tar -xOf - usr/bin/restic >"$bin/restic.new"
else
  tag=${image#*:}
  tag=${tag%@*}
  commit=${tag#sha-}
  source=$(mktemp -d)
  trap 'rm -rf "$source"' EXIT
  git clone -q --filter=blob:none --no-checkout https://github.com/futo-org/restic.git "$source"
  git -C "$source" checkout -q "$commit"
  sed -i.orig -E "s/^const Version = \"([^\"]+)\"$/const Version = \"\1+futo.$commit\"/" "$source/internal/global/global.go"
  (cd "$source" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -tags disable_grpc_modules -o "$bin/restic.new" ./cmd/restic)
fi

chmod +x "$bin/restic.new"
mv "$bin/restic.new" "$bin/restic"
printf '%s\n' "$image" >"$marker"
"$bin/restic" version
