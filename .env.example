# Values may be literals or 1Password `op://<vault>/<item>/<field>` references,
# resolved with `op read` at startup.
# OP_ACCOUNT="<your-account>.1password.com"

# OIDC: defaults target the local mock-oidc-provider. Point these at a real
# provider to log in through it instead.
# WEB_PORT="5173"
# OIDC_ISSUER="https://<issuer>"
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI="http://localhost:5173/api/auth/oidc/callback"
# OIDC_TICKET_REDIRECT_URI="http://localhost:5173/api/auth/ticket/callback"
# OIDC_LOGOUT_REDIRECT_URI="http://localhost:5173"

# Polar
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID=
# POLAR_APPLY_DISCOUNT_ID=

# Resend: defaults target the local mock (compose/Tilt). Set both to send
# real email from a dev machine.
# RESEND_API_URL="https://api.resend.com"
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS="FUTO Backups <noreply@backups.futo.cloud>"

# futo-backups-bot: without a token the bot idles. Point it at your dev guild
# (ids from Discord's developer mode) to run the real flow.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_STAFF_ROLE_ID=
# DISCORD_SUPPORT_CHANNEL_ID=
# DISCORD_TICKET_CATEGORY_ID=
# DISCORD_ARCHIVE_CATEGORY_ID=

# Enable after every API replica uses atomic invite redemption and old requests have drained.
# DISCORD_INVITE_RECYCLING_ENABLED=false
