// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`BetaInvitesRepository getBackedUpAccountCount counts non-FUTO accounts with at least one completed backup in their history 1`] = `
[
  [
    "select count(*) as "count" from "users" where lower("users"."email") not like $1 and lower("users"."email") not like $2 and exists (select "repositories"."id" from "repositories" inner join "repositoryMetricsHistory" on "repositoryMetricsHistory"."repositoryId" = "repositories"."id" where "repositories"."userId" = "users"."id" and "repositoryMetricsHistory"."backupStatus" = $3)",
    [
      "%@futo.org",
      "%@futo.tech",
      "complete",
    ],
  ],
]
`;
