#!/usr/bin/env bash
#MISE description="Publish packages/docs/build to Cloudflare Pages (ENVIRONMENT=prod|dev, STAGE=pr-<n> for a preview)"
#MISE dir="{{config_root}}/../.."
set -euo pipefail

: "${CLOUDFLARE_API_TOKEN:?a Pages-scoped Cloudflare API token is required}"
: "${CLOUDFLARE_ACCOUNT_ID:?}"
environment="${ENVIRONMENT:-dev}"
project="docs-futo-cloud-${environment}"

if [ "$environment" = prod ]; then
  branch=main
  hostname=docs.futo.cloud
else
  branch="${STAGE:?set STAGE=pr-<n> to name the preview}"
  hostname="${branch}.${project}.pages.dev"
fi

[ -d packages/docs/build ] || { echo "docs:deploy: packages/docs/build is missing — run mise //packages/docs:build first" >&2; exit 1; }

wrangler pages deploy packages/docs/build --project-name="$project" --branch="$branch" --commit-dirty=true

echo "deployed https://${hostname}"
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  echo "hostname=${hostname}" >> "$GITHUB_OUTPUT"
fi
