{
  "name": "@futo-org/backups-orchestrator-api",
  "repository": "https://github.com/immich-app/yucca",
  "version": "0.48.0",
  "description": "Backups orchestrator (API)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "nest build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-integration.json --runInBand",
    "dev": "nest start --watch --entryFile bin/server",
    "start": "node dist/bin/server.js",
    "sync:openapi": "nest build && node dist/bin/sync-openapi.js"
  },
  "keywords": [],
  "author": "",
  "license": "Source First License 1.1",
  "packageManager": "pnpm@10.28.1",
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "^12.0.0"
  },
  "dependencies": {
    "@futo-org/restic-wrapper": "catalog:",
    "@nestjs/event-emitter": "catalog:",
    "@nestjs/jwt": "catalog:",
    "better-sqlite3": "catalog:",
    "cookie": "catalog:",
    "cron": "catalog:",
    "event-iterator": "catalog:",
    "eventsource-client": "catalog:",
    "express": "catalog:",
    "kysely": "catalog:",
    "nestjs-kysely": "catalog:",
    "nestjs-zod": "catalog:",
    "openid-client": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "tail": "catalog:",
    "zod": "catalog:",
    "@futo-org/backups-api-client": "workspace:^"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/tail": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:"
  },
  "files": [
    "dist",
    "!dist/bin"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
