<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FutoBackups.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FutoBackups.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings\Text.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="FutoBackups.Core.Strings" StronglyTypedClassName="Text" StronglyTypedFileName="$(IntermediateOutputPath)Text.Designer.cs" PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>
</Project>
