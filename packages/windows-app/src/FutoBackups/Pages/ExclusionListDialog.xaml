<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FutoBackups.Pages.ExclusionListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:vm="using:FutoBackups.ViewModels"
    Title="{x:Bind s:Text.FoldersExcluded}"
    PrimaryButtonText="{x:Bind s:Text.CommonDone}"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="10" Width="520">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="{x:Bind s:Text.FoldersSearch}"
                AutomationProperties.Name="{x:Bind s:Text.FoldersSearch}"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
        <ListView
            x:Name="List"
            Height="320"
            SelectionMode="Multiple"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind s:Text.FoldersExcluded}"
            SelectionChanged="List_SelectionChanged">
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Delete" Invoked="Delete_Invoked" />
            </ListView.KeyboardAccelerators>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExclusionRow">
                    <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Pattern}" AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind s:Text.FoldersException}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind IsException}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Content="{x:Bind s:Text.CommonRemove}" Command="{x:Bind ViewModel.RemoveSelectedCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</ContentDialog>
