<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FutoBackups.Pages.Settings.DeleteBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanUsePrimary, Mode=OneWay}"
    SecondaryButtonText="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.CloseText, Mode=OneWay}"
    PrimaryButtonCommand="{x:Bind ViewModel.PrimaryCommand}"
    SecondaryButtonCommand="{x:Bind ViewModel.SecondaryCommand}"
    PrimaryButtonClick="KeepOpen"
    SecondaryButtonClick="KeepOpen"
    CloseButtonClick="Dialog_CloseButtonClick">
    <StackPanel Spacing="16" Width="440">
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsIntroducing, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Explanation, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind s:Text.SettingsDeleteBackupBrowserOpens}" TextWrapping="Wrap" />
            <CheckBox Content="{x:Bind s:Text.SettingsDeleteBackupUnderstood}" IsChecked="{x:Bind ViewModel.Understood, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.ShowsProgress, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.ShowsProgress, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsConfirmingInBrowser, Mode=OneWay}">
            <TextBlock Text="{x:Bind s:Text.SettingsDeleteBackupConfirmBody}" TextWrapping="Wrap" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsConfirmingInBrowser, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasOtherBackups, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.OtherBackups, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind s:Text.SettingsDeleteBackupDeleteThem}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource BodySecondaryTextStyle}" Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
