<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FutoBackups.Pages.Overview.WarningsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:i="using:FutoBackups"
    xmlns:vm="using:FutoBackups.ViewModels"
    Title="{x:Bind ViewModel.Headline}"
    PrimaryButtonText="{x:Bind s:Text.CommonDone}"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer>
        <StackPanel Spacing="16" Width="540">
            <TextBlock Text="{x:Bind s:Text.OverviewWarningsIntro}" Style="{StaticResource BodySecondaryTextStyle}" />
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.ListTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="4,0"
                        Content="{x:Bind s:Text.OverviewExcludeAll}"
                        ToolTipService.ToolTip="{x:Bind s:Text.OverviewExcludeAllToolTip}"
                        Visibility="{x:Bind ViewModel.CanExcludeAll, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ExcludeAllCommand}" />
                    <HyperlinkButton Grid.Column="2" Padding="4,0" Content="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CopyCommand}" />
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="0" Height="240">
                    <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WarningRow">
                                <Grid ColumnSpacing="10" Padding="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Path}"
                                            ToolTipService.ToolTip="{x:Bind Path}"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Reason}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind s:Text.FoldersExcluded}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsExcluded, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind s:Text.OverviewInFolders}"
                                        ToolTipService.ToolTip="{x:Bind s:Text.OverviewInFoldersToolTip}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsInFolders, Mode=OneWay}" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        Content="{x:Bind s:Text.OverviewExclude}"
                                        ToolTipService.ToolTip="{x:Bind s:Text.OverviewExcludeToolTip}"
                                        AutomationProperties.Name="{x:Bind ExcludeName}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind CanExclude, Mode=OneWay}"
                                        Command="{x:Bind ExcludeCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind s:Text.OverviewCommonCauses}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="{x:Bind i:Icons.Lock}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind s:Text.OverviewCauseLocked}" TextWrapping="Wrap" />
                    <FontIcon Grid.Row="1" Glyph="{x:Bind i:Icons.Permissions}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind s:Text.OverviewCausePermission}" TextWrapping="Wrap" />
                    <FontIcon Grid.Row="2" Glyph="{x:Bind i:Icons.Sync}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind s:Text.OverviewCauseChanged}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
