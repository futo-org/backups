<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FutoBackups.Pages.Overview.CloudOnlyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    Title="{x:Bind s:Text.OverviewCloudOnlyTitle}"
    PrimaryButtonText="{x:Bind s:Text.CommonDone}"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer>
        <StackPanel Spacing="16" Width="500">
            <TextBlock Text="{x:Bind Intro}" Style="{StaticResource BodySecondaryTextStyle}" />
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Skip.ListTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" Padding="4,0" Content="{x:Bind CopyLabel, Mode=OneWay}" Command="{x:Bind CopyCommand}" />
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="12" Height="200">
                    <ScrollViewer>
                        <TextBlock Text="{x:Bind Paths}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind s:Text.OverviewToBackThemUp}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="1." FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind s:Text.OverviewCloudOnlyStepFiles}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="2." FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind s:Text.OverviewCloudOnlyStepOneDrive}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{x:Bind s:Text.OverviewCloudOnlyOtherApps}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
