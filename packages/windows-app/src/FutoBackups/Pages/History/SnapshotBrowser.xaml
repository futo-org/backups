<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FutoBackups.Pages.History.SnapshotBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:i="using:FutoBackups"
    xmlns:vm="using:FutoBackups.ViewModels"
    PrimaryButtonText="{x:Bind ViewModel.RestoreTitle, Mode=OneWay}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}"
    CloseButtonText="{x:Bind s:Text.CommonCancel}"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>
    <Grid RowSpacing="14" Width="652" Height="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind i:Icons.Copy}" FontSize="28" VerticalAlignment="Top" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Bind s:Text.RestoreFiles}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2">
            <Button
                Style="{StaticResource SubtleButtonStyle}"
                Padding="6"
                Command="{x:Bind ViewModel.BackCommand}"
                AutomationProperties.Name="{x:Bind s:Text.CommonBack}"
                ToolTipService.ToolTip="{x:Bind s:Text.CommonBack}">
                <FontIcon Glyph="{x:Bind i:Icons.ChevronLeft}" FontSize="12" />
            </Button>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Crumbs, Mode=OneWay}" IsTabStop="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Crumb">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                Glyph="{x:Bind i:Icons.ChevronRight}"
                                FontSize="10"
                                Margin="4,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ShowsSeparator}" />
                            <HyperlinkButton Content="{x:Bind Title}" Padding="4,2" Command="{x:Bind OpenCommand}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="48,8,44,8"
                    ColumnSpacing="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind s:Text.RestoreName}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind s:Text.RestoreDateModified}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind s:Text.RestoreSize}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24,0">
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{x:Bind ViewModel.ShowsEmpty, Mode=OneWay}" />
                    <Button
                        Content="{x:Bind s:Text.CommonTryAgain}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Visibility="{x:Bind ViewModel.ShowsRetry, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    Grid.Row="1"
                    Width="24"
                    Height="24"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind s:Text.RestoreLoadingFolder}" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="0,4"
                    AutomationProperties.Name="{x:Bind s:Text.RestoreFolderContents}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryRow">
                            <Grid ColumnSpacing="10" Padding="0,4" DoubleTapped="Row_DoubleTapped" Tapped="Row_Tapped" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    Padding="0"
                                    IsChecked="{x:Bind IsIncluded, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsSelectable, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Entry.Name}"
                                    ToolTipService.ToolTip="{x:Bind CoveredHelp, Mode=OneWay}" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Entry.Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind DisplayPath}"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ShowsPath}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="5"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="4"
                                    Command="{x:Bind OpenCommand}"
                                    Visibility="{x:Bind Entry.IsDirectory}"
                                    AutomationProperties.Name="{x:Bind OpenLabel}"
                                    ToolTipService.ToolTip="{x:Bind OpenLabel}">
                                    <FontIcon Glyph="{x:Bind i:Icons.ChevronRight}" FontSize="11" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <HyperlinkButton
                Content="{x:Bind s:Text.RestoreClear}"
                Padding="0"
                FontSize="12"
                Command="{x:Bind ViewModel.ClearCommand}"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
