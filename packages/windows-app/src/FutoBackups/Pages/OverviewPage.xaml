<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FutoBackups.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:i="using:FutoBackups"
    xmlns:controls="using:FutoBackups.Controls"
    xmlns:vm="using:FutoBackups.ViewModels"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1040" />
            </Grid.ColumnDefinitions>
        <StackPanel Padding="36,20,36,36" Spacing="12">
            <controls:PageHeader Title="{x:Bind s:Text.CommonOverview}" />
            <InfoBar
                Title="{x:Bind s:Text.OverviewMissingOnServiceTitle}"
                Message="{x:Bind s:Text.OverviewMissingOnServiceMessage}"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsMissingOnService, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind s:Text.OverviewStartNewBackup}" Command="{x:Bind ViewModel.StartReplacementCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsMissingRecoveryKey, Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind i:Icons.Permissions}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind s:Text.KeyMissingTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind s:Text.KeyMissingSubtitle}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind s:Text.KeyEnterRecoveryKey}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Command="{x:Bind Status.EnterRecoveryKeyCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="28">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:StatusRing Diameter="112" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Status.StatusTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock
                            Text="{x:Bind Status.StatusSubtitle, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Status.LastBackupTooltip, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind s:Text.OverviewContinuesInBackground}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind Status.IsBusy, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8"
                                Visibility="{x:Bind Status.ShowsBackUpAction, Mode=OneWay}"
                                Command="{x:Bind Status.BackUpNowCommand}" AutomationProperties.Name="{x:Bind Status.BackUpActionLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind i:Icons.Upload}" FontSize="16" />
                                    <TextBlock Text="{x:Bind Status.BackUpActionLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8"
                                Visibility="{x:Bind Status.ShowsAddFoldersAction, Mode=OneWay}"
                                Command="{x:Bind Status.AddFoldersCommand}" AutomationProperties.Name="{x:Bind s:Text.OverviewAddFolders}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind i:Icons.Add}" FontSize="16" />
                                    <TextBlock Text="{x:Bind s:Text.OverviewAddFolders}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Content="{x:Bind s:Text.CommonSignIn}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8"
                                Visibility="{x:Bind Status.ShowsSignInAction, Mode=OneWay}"
                                Command="{x:Bind Status.SignInCommand}" />
                            <Button
                                Content="{x:Bind s:Text.KeyEnterRecoveryKey}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8"
                                Visibility="{x:Bind Status.ShowsRecoveryKeyAction, Mode=OneWay}"
                                Command="{x:Bind Status.EnterRecoveryKeyCommand}" />
                            <Button
                                Content="{x:Bind s:Text.CommonCancel}"
                                Padding="16,8"
                                Visibility="{x:Bind Status.ShowsCancelAction, Mode=OneWay}"
                                Command="{x:Bind Status.CancelCommand}" />
                            <Button
                                Padding="16,8"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ShowWarningsCommand}" AutomationProperties.Name="{x:Bind s:Text.OverviewShowWarnings}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind i:Icons.Warning}" FontSize="16" />
                                    <TextBlock Text="{x:Bind s:Text.OverviewShowWarnings}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:UploadSpeedCard Visibility="{x:Bind Status.IsUploading, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsCloudOnlyNotice, Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind i:Icons.Cloud}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.CloudOnlyHeadline, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind s:Text.OverviewCloudOnlyHint}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind s:Text.OverviewShowFiles}" VerticalAlignment="Center" Command="{x:Bind ViewModel.ShowCloudOnlyCommand}" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind i:Icons.Calendar}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind s:Text.OverviewNextBackup}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind Status.NextBackup, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.NextBackupTooltip, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind i:Icons.HardDrive}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind s:Text.OverviewProtected}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ProtectedText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind i:Icons.History}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind s:Text.OverviewSnapshots}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SnapshotCountText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind i:Icons.Recent}" Style="{StaticResource CardIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind s:Text.CommonSchedule}" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ScheduleDescription, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.UpcomingRuns, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasUpcomingRuns, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CanPauseSchedule, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.TogglePauseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.PauseLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <ComboBox
                            Grid.Column="3"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            SelectedIndex="{x:Bind ViewModel.ScheduleIndex, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind s:Text.CommonSchedule}">
                            <ComboBoxItem Content="{x:Bind s:Text.ScheduleManual}" />
                            <ComboBoxItem Content="{x:Bind s:Text.ScheduleHourly}" />
                            <ComboBoxItem Content="{x:Bind s:Text.ScheduleDaily}" />
                            <ComboBoxItem Content="{x:Bind s:Text.ScheduleWeekly}" />
                            <ComboBoxItem Content="{x:Bind s:Text.ScheduleCustom}" />
                        </ComboBox>
                    </Grid>
                    <Grid
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.ShowsTime, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ComboBox
                                MinWidth="160"
                                ItemsSource="{x:Bind ViewModel.Weekdays}"
                                SelectedIndex="{x:Bind ViewModel.WeekdayIndex, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.ShowsWeekday, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind s:Text.OverviewDay}" />
                            <TimePicker
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="5"
                                Time="{x:Bind ViewModel.ScheduleTime, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind s:Text.OverviewTime}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        Padding="16,12"
                        Spacing="6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.ShowsCron, Mode=OneWay}">
                        <TextBox
                            x:Name="CronBox"
                            Header="{x:Bind s:Text.ScheduleCronLabel}"
                            Text="{x:Bind ViewModel.CronDraft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            KeyDown="CronBox_KeyDown" />
                        <TextBlock Text="{x:Bind ViewModel.CronMessage, Mode=OneWay}" Foreground="{x:Bind ViewModel.CronMessageBrush, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Visibility="{x:Bind ViewModel.HasCronMessage, Mode=OneWay}" />
                    </StackPanel>
                    <Grid
                        Padding="16,10"
                        ColumnSpacing="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FolderPills, Mode=OneWay}" VerticalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderItem">
                                    <Border Style="{StaticResource PillStyle}" ToolTipService.ToolTip="{x:Bind Path}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind i:Icons.Folder}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.ExtraFolderText, Mode=OneWay}"
                            Style="{StaticResource SecondaryTextStyle}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasExtraFolders, Mode=OneWay}" />
                        <HyperlinkButton Grid.Column="3" Content="{x:Bind s:Text.CommonEdit}" Command="{x:Bind Status.AddFoldersCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsFailureNotificationHint, Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind i:Icons.Shield}" Style="{StaticResource CardIconStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind s:Text.OverviewNotifyTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind s:Text.OverviewNotifyBody}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind s:Text.OverviewTurnOn}" VerticalAlignment="Center" Command="{x:Bind ViewModel.TurnOnFailureNotificationsCommand}" />
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.DismissFailureHintCommand}"
                        AutomationProperties.Name="{x:Bind s:Text.CommonDismiss}"
                        ToolTipService.ToolTip="{x:Bind s:Text.CommonDismiss}">
                        <FontIcon Glyph="{x:Bind i:Icons.Cancel}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
