<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FutoBackups.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:i="using:FutoBackups"
    xmlns:controls="using:FutoBackups.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Text="{x:Bind s:Text.CommonAppName}"
                Grid.Column="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
            <controls:AlphaBadge Grid.Column="2" VerticalAlignment="Center" />
        </Grid>

        <Frame
            x:Name="FlowFrame"
            Grid.Row="1"
            Visibility="{x:Bind Shell.IsInFlow, Mode=OneWay}" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Visibility="{x:Bind Shell.IsInMain, Mode=OneWay}"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="overview" AutomationProperties.Name="{x:Bind s:Text.CommonOverview}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind s:Text.CommonOverview}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Status.SidebarProgress, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,12,0"
                            Visibility="{x:Bind Status.HasSidebarProgress, Mode=OneWay}" />
                    </Grid>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind i:Icons.Home}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind s:Text.CommonFolders}" Tag="folders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind i:Icons.Folder}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind s:Text.CommonHistory}" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind i:Icons.History}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind s:Text.SettingsTitle}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind i:Icons.Setting}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="12"
                    Padding="10"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture Width="30" Height="30" Initials="{x:Bind Account.Initials, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind Account.Email, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Account.ServerLine, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <controls:StartupFailureBar Margin="36,20,36,0" MaxWidth="1040" />
                    <InfoBar
                        Title="{x:Bind s:Text.ErrorSomethingWentWrong}"
                        Message="{x:Bind Status.ErrorText, Mode=OneWay}"
                        Severity="Error"
                        Margin="36,20,36,0"
                        MaxWidth="1040"
                        IsOpen="{x:Bind Status.HasError, Mode=OneWay}"
                        IsClosable="True"
                        CloseButtonCommand="{x:Bind Status.DismissErrorCommand}" />
                    <InfoBar
                        Title="{x:Bind Shell.CompletionTitle, Mode=OneWay}"
                        Message="{x:Bind Shell.CompletionMessage, Mode=OneWay}"
                        Severity="{x:Bind Shell.CompletionSeverity, Mode=OneWay}"
                        Margin="36,20,36,0"
                        MaxWidth="1040"
                        IsOpen="{x:Bind Shell.IsCompletionOpen, Mode=TwoWay}"
                        IsClosable="True"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
