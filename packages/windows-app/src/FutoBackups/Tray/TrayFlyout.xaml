<Window
    x:Class="FutoBackups.Tray.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:FutoBackups.Core.Strings"
    xmlns:i="using:FutoBackups"
    xmlns:controls="using:FutoBackups.Controls">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <StackPanel x:Name="Root" Padding="16" Spacing="14" VerticalAlignment="Top">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:StatusRing Diameter="42" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Status.CompactTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{x:Bind Status.CompactSubtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <controls:AlphaBadge Grid.Column="2" VerticalAlignment="Top" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Status.IsUploading, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind i:Icons.Upload}" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind Status.UploadRate, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.Name="{x:Bind Status.UploadSummary, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Status.UploadDetails, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnSpacing="8" Visibility="{x:Bind Status.HasError, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind i:Icons.Warning}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="1" Text="{x:Bind Status.ErrorText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            </Grid>
            <Border Style="{StaticResource CardStyle}" Padding="12,10" Visibility="{x:Bind Status.SignedIn, Mode=OneWay}">
                <Grid RowSpacing="8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind s:Text.TrayFlyoutLastBackup}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Status.LastBackupText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{x:Bind s:Text.TrayFlyoutNextBackup}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Status.NextBackup, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <Button
                x:Name="BackUpButton"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Content="{x:Bind Status.BackUpActionLabel, Mode=OneWay}"
                IsEnabled="{x:Bind Status.CanBackUp, Mode=OneWay}"
                Visibility="{x:Bind Status.ShowsBackUpAction, Mode=OneWay}"
                Command="{x:Bind Status.BackUpNowCommand}" />
            <Button
                x:Name="CancelButton"
                HorizontalAlignment="Stretch"
                Content="{x:Bind s:Text.CommonCancel}"
                Visibility="{x:Bind Status.ShowsCancelAction, Mode=OneWay}"
                Click="Cancel_Click" />
            <Rectangle Height="1" Margin="-16,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid Margin="-6,-4,-6,-6" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                    <Style TargetType="FontIcon">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </Grid.Resources>
                <Button
                    x:Name="OpenButton"
                    AutomationProperties.Name="{x:Bind s:Text.TrayOpen}"
                    ToolTipService.ToolTip="{x:Bind s:Text.TrayOpen}"
                    Click="Open_Click">
                    <FontIcon Glyph="{x:Bind i:Icons.OpenInNewWindow}" />
                </Button>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Bind s:Text.CommonAppHelp}"
                    ToolTipService.ToolTip="{x:Bind s:Text.CommonAppHelp}"
                    Click="Help_Click">
                    <FontIcon Glyph="{x:Bind i:Icons.Help}" />
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="{x:Bind s:Text.TrayCheckForUpdates}"
                    ToolTipService.ToolTip="{x:Bind s:Text.TrayCheckForUpdates}"
                    Visibility="{x:Bind UpdatesAvailable}"
                    Click="CheckForUpdates_Click">
                    <FontIcon Glyph="{x:Bind i:Icons.Sync}" />
                </Button>
                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="{x:Bind s:Text.TrayQuit}"
                    AutomationProperties.HelpText="{x:Bind s:Text.TrayQuitHelp}"
                    ToolTipService.ToolTip="{x:Bind s:Text.TrayQuitHelp}"
                    Click="Quit_Click">
                    <FontIcon Glyph="{x:Bind i:Icons.PowerButton}" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
