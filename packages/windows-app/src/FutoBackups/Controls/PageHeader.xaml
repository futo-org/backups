<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FutoBackups.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid ColumnSpacing="12" Margin="0,12,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource SecondaryTextStyle}"
                FontSize="13"
                Visibility="Collapsed" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{x:Bind Actions}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
